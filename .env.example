# Where the plans come from at build; without it the build fails unless PLANS_FIXTURE=1.
PLANS_API_URL=https://api.myfitally.com/fitness/plans
# 1 builds with the committed fixture when PLANS_API_URL is empty.
PLANS_FIXTURE=
# Digits only, with the country code (5511...). A generate with PLANS_API_URL refuses to run
# without it.
NUXT_PUBLIC_WHATSAPP_NUMBER=
# The sign-in and purchase API, called from the browser; production when unset.
NUXT_PUBLIC_API_URL=https://api.myfitally.com
# Each script loads only when its id is set, and only after consent.
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_META_PIXEL_ID=
