{
  "name": "codart-fitness-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/fonts": "~1.1.0",
    "@nuxt/image": "^2.2.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "intl-messageformat": "^12.1.4",
    "nuxt": "^4.6.2",
    "nuxt-schema-org": "^7.0.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{ts,vue,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
